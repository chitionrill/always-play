diff --git a/src/client/java/soke/musicdelay/client/playback/JukeboxDuckController.java b/src/client/java/soke/musicdelay/client/playback/JukeboxDuckController.java
new file mode 100644
index 0000000..de553df
--- /dev/null
+++ b/src/client/java/soke/musicdelay/client/playback/JukeboxDuckController.java
@@ -0,0 +1,104 @@
+package soke.musicdelay.client.playback;
+
+import net.minecraft.client.Minecraft;
+import net.minecraft.client.multiplayer.ClientLevel;
+import net.minecraft.core.BlockPos;
+import net.minecraft.sounds.SoundSource;
+import net.minecraft.world.level.ChunkPos;
+import net.minecraft.world.level.block.entity.BlockEntity;
+import net.minecraft.world.level.block.entity.JukeboxBlockEntity;
+import net.minecraft.world.level.chunk.LevelChunk;
+import soke.musicdelay.ModConfig;
+import soke.musicdelay.client.IMusicManagerMixin;
+import soke.musicdelay.client.WavPlayer;
+
+// Плавно приглушает музыку MDR (и ванильную через IMusicManagerMixin, и кастомную через
+// WavPlayer.duckMultiplier), пока рядом с игроком играет пластинка в проигрывателе, и плавно
+// возвращает громкость обратно, когда пластинка остановилась/её вытащили ИЛИ игрок отошёл за
+// пределы детект-радиуса. Сам трек MDR при этом никогда не останавливается — только громкость
+// идёт к 0 и обратно, поэтому возобновление всегда мгновенное и без повторной загрузки.
+public class JukeboxDuckController {
+
+    // Сканируем не каждый тик — обход блок-энтити в загруженных чанках не бесплатный,
+    // а для плавности fade достаточно свежих данных раз в четверть секунды.
+    private static final int SCAN_INTERVAL_TICKS = 5;
+
+    private static float duckFactor = 1.0f; // 1.0 = музыка MDR полностью слышна, 0.0 = приглушена
+    private static int scanCountdown = 0;
+    private static boolean jukeboxNearby = false;
+
+    public static void tick(Minecraft client, IMusicManagerMixin mixin) {
+        ModConfig config = ModConfig.get();
+
+        if (!config.jukeboxDuckingEnabled) {
+            // Фича выключена в настройках — гарантируем, что множитель не завис на приглушённом
+            // значении с прошлой сессии/до выключения тумблера.
+            if (duckFactor != 1.0f) {
+                duckFactor = 1.0f;
+                applyGain(client, mixin);
+            }
+            return;
+        }
+
+        if (--scanCountdown <= 0) {
+            scanCountdown = SCAN_INTERVAL_TICKS;
+            jukeboxNearby = isPlayingJukeboxNearby(client, config.jukeboxDetectionRadius);
+        }
+
+        float target = jukeboxNearby ? 0.0f : 1.0f;
+        float durationTicks = (float) Math.max(1.0, config.jukeboxDuckFadeSeconds) * 20f;
+        float step = 1.0f / durationTicks;
+
+        if (duckFactor < target) {
+            duckFactor = Math.min(target, duckFactor + step);
+        } else if (duckFactor > target) {
+            duckFactor = Math.max(target, duckFactor - step);
+        }
+
+        applyGain(client, mixin);
+    }
+
+    private static void applyGain(Minecraft client, IMusicManagerMixin mixin) {
+        float sliderVolume = client.options.getSoundSourceVolume(SoundSource.MUSIC);
+        mixin.mdr$setGain(sliderVolume * duckFactor);
+        WavPlayer.setDuckMultiplier(duckFactor);
+    }
+
+    // ВАЖНО (нужна проверка на 26.2): isRecordPlaying() — это имя метода по аналогии со старыми
+    // версиями маппинга (isPlayingRecord в Yarn 1.19+). Если gradlew build упадёт именно на этой
+    // строке — открой JukeboxBlockEntity в IDE (Ctrl+клик) и пришли мне точное имя метода,
+    // проверяющего "пластинка сейчас играет" — поправлю за секунду. Остальной код этого файла
+    // от точного имени метода не зависит.
+    private static boolean isPlayingJukeboxNearby(Minecraft client, int radius) {
+        ClientLevel level = client.level;
+        if (level == null || client.player == null) return false;
+
+        BlockPos playerPos = client.player.blockPosition();
+        int chunkRadius = (radius >> 4) + 1;
+        ChunkPos centerChunk = new ChunkPos(playerPos);
+        double radiusSq = (double) radius * radius;
+
+        for (int cx = centerChunk.x - chunkRadius; cx <= centerChunk.x + chunkRadius; cx++) {
+            for (int cz = centerChunk.z - chunkRadius; cz <= centerChunk.z + chunkRadius; cz++) {
+                if (!level.hasChunk(cx, cz)) continue;
+                LevelChunk chunk = level.getChunk(cx, cz);
+                for (BlockEntity be : chunk.getBlockEntities().values()) {
+                    if (!(be instanceof JukeboxBlockEntity jukebox)) continue;
+                    if (!jukebox.isRecordPlaying()) continue;
+                    if (jukebox.getBlockPos().distSqr(playerPos) <= radiusSq) {
+                        return true;
+                    }
+                }
+            }
+        }
+        return false;
+    }
+
+    // Вызывать из restartForWorldJoin()/resetPlaybackState() — иначе при заходе в новый мир
+    // duckFactor мог бы остаться приглушённым с прошлой сессии до первого нового скана.
+    public static void reset() {
+        duckFactor = 1.0f;
+        scanCountdown = 0;
+        jukeboxNearby = false;
+    }
+}
